# tool caches and test output (regenerate any time)
tools/.cache/
node_modules/
qa_out/
lh/
firstscreen.json
*.zip
.DS_Store
Thumbs.db
# real lead / client data never goes to git (only *.example.* files)
data/*
# generated quotes and any other per-client output (tools/make_quote.py writes here)
out/
!data/*.example.*
.env
__pycache__/

# real client folders = personal data (Duet / client_folder.py default root)
clients/

# --- Aggi (new-customer WhatsApp agent) and general safety: the repo is PUBLIC ---
# real conversations, customer data, logs and recordings of the agent
Aggi*/clients/
Aggi*/data/
Aggi*/conversations/
Aggi*/logs/
Aggi*/**/*.vtt
Aggi*/**/*.mp3
Aggi*/**/*.m4a
Aggi*/**/*.wav
# secrets and personal local settings, any folder
.env.*
!.env.example
*.key
*.pem
secrets/
.claude/settings.local.json
*.local.*
